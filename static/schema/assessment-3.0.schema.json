{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sovereign.polla.dev/schema/assessment-3.0.schema.json",
  "title": "Sovereign Software Assessment, schema version 3.0",
  "description": "Export format of the Sovereign Software Evaluator. The determination is informational and is recomputed on import. The framework adopts no numerical score.",
  "type": "object",
  "required": [
    "schemaVersion"
  ],
  "properties": {
    "schemaVersion": {
      "const": "3.0"
    },
    "framework": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "status": {
          "type": "string"
        }
      }
    },
    "software": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "maxLength": 200
        },
        "version": {
          "type": "string",
          "maxLength": 200
        },
        "category": {
          "type": "string",
          "maxLength": 200
        },
        "platform": {
          "type": "string",
          "maxLength": 200
        },
        "deployment": {
          "type": "string",
          "maxLength": 200
        }
      }
    },
    "evaluation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "date": {
          "type": "string",
          "pattern": "^(\\d{4}-\\d{2}-\\d{2})?$"
        },
        "evaluator": {
          "type": "string",
          "maxLength": 200
        },
        "notes": {
          "type": "string",
          "maxLength": 5000
        }
      }
    },
    "eligibility": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "E1": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "status": {
              "enum": [
                "pass",
                "fail",
                "not_verified",
                "not_applicable"
              ]
            },
            "evidence": {
              "type": "string",
              "maxLength": 5000
            },
            "justification": {
              "type": "string",
              "maxLength": 5000
            },
            "source": {
              "type": "string",
              "maxLength": 2000,
              "pattern": "^(https?://\\S+)?$"
            }
          }
        },
        "E2": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "status": {
              "enum": [
                "pass",
                "fail",
                "not_verified",
                "not_applicable"
              ]
            },
            "evidence": {
              "type": "string",
              "maxLength": 5000
            },
            "justification": {
              "type": "string",
              "maxLength": 5000
            },
            "source": {
              "type": "string",
              "maxLength": 2000,
              "pattern": "^(https?://\\S+)?$"
            }
          }
        },
        "E3": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "status": {
              "enum": [
                "pass",
                "fail",
                "not_verified",
                "not_applicable"
              ]
            },
            "evidence": {
              "type": "string",
              "maxLength": 5000
            },
            "justification": {
              "type": "string",
              "maxLength": 5000
            },
            "source": {
              "type": "string",
              "maxLength": 2000,
              "pattern": "^(https?://\\S+)?$"
            }
          }
        },
        "E4": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "status": {
              "enum": [
                "pass",
                "fail",
                "not_verified",
                "not_applicable"
              ]
            },
            "evidence": {
              "type": "string",
              "maxLength": 5000
            },
            "justification": {
              "type": "string",
              "maxLength": 5000
            },
            "source": {
              "type": "string",
              "maxLength": 2000,
              "pattern": "^(https?://\\S+)?$"
            }
          }
        },
        "E5": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "status": {
              "enum": [
                "pass",
                "fail",
                "not_verified",
                "not_applicable"
              ]
            },
            "evidence": {
              "type": "string",
              "maxLength": 5000
            },
            "justification": {
              "type": "string",
              "maxLength": 5000
            },
            "source": {
              "type": "string",
              "maxLength": 2000,
              "pattern": "^(https?://\\S+)?$"
            }
          }
        }
      }
    },
    "principles": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sovereignty": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "finding": {
              "enum": [
                null,
                "meets",
                "partial",
                "does_not_meet"
              ]
            },
            "evidence": {
              "type": "string",
              "maxLength": 5000
            },
            "limitations": {
              "type": "string",
              "maxLength": 5000
            },
            "confidence": {
              "enum": [
                null,
                "high",
                "medium",
                "low"
              ]
            },
            "sources": {
              "type": "string",
              "maxLength": 5000,
              "description": "One http or https URL per line"
            }
          }
        },
        "longevity": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "finding": {
              "enum": [
                null,
                "meets",
                "partial",
                "does_not_meet"
              ]
            },
            "evidence": {
              "type": "string",
              "maxLength": 5000
            },
            "limitations": {
              "type": "string",
              "maxLength": 5000
            },
            "confidence": {
              "enum": [
                null,
                "high",
                "medium",
                "low"
              ]
            },
            "sources": {
              "type": "string",
              "maxLength": 5000,
              "description": "One http or https URL per line"
            }
          }
        },
        "locality": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "finding": {
              "enum": [
                null,
                "meets",
                "partial",
                "does_not_meet"
              ]
            },
            "evidence": {
              "type": "string",
              "maxLength": 5000
            },
            "limitations": {
              "type": "string",
              "maxLength": 5000
            },
            "confidence": {
              "enum": [
                null,
                "high",
                "medium",
                "low"
              ]
            },
            "sources": {
              "type": "string",
              "maxLength": 5000,
              "description": "One http or https URL per line"
            }
          }
        },
        "transparency": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "finding": {
              "enum": [
                null,
                "meets",
                "partial",
                "does_not_meet"
              ]
            },
            "evidence": {
              "type": "string",
              "maxLength": 5000
            },
            "limitations": {
              "type": "string",
              "maxLength": 5000
            },
            "confidence": {
              "enum": [
                null,
                "high",
                "medium",
                "low"
              ]
            },
            "sources": {
              "type": "string",
              "maxLength": 5000,
              "description": "One http or https URL per line"
            }
          }
        }
      }
    },
    "tests": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "T1": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "checked": {
              "type": "array",
              "items": {
                "type": "boolean"
              },
              "minItems": 4,
              "maxItems": 4,
              "description": "Verification items in order: Independent access to essential information; Complete export; Practical migration to another tool; Key custody and recovery explained, where applicable"
            },
            "notes": {
              "type": "string",
              "maxLength": 5000
            }
          }
        },
        "T2": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "checked": {
              "type": "array",
              "items": {
                "type": "boolean"
              },
              "minItems": 4,
              "maxItems": 4,
              "description": "Verification items in order: Documented formats and schemas; Metadata and relationships preserved; Backups tested and restoration demonstrated; Independent interpretation of the records"
            },
            "notes": {
              "type": "string",
              "maxLength": 5000
            }
          }
        },
        "T3": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "checked": {
              "type": "array",
              "items": {
                "type": "boolean"
              },
              "minItems": 3,
              "maxItems": 3,
              "description": "Verification items in order: Functions that continue without external services; Each remaining dependency shown to be inherent to the task; A failed synchronization does not remove the ability to work"
            },
            "notes": {
              "type": "string",
              "maxLength": 5000
            }
          }
        },
        "T4": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "checked": {
              "type": "array",
              "items": {
                "type": "boolean"
              },
              "minItems": 5,
              "maxItems": 5,
              "description": "Verification items in order: Rules for important operations are explained; Consequential actions and outcomes are traceable; Suggestions are distinct from committed actions; Approval, reversal, or contest is available where appropriate; Errors are visible"
            },
            "notes": {
              "type": "string",
              "maxLength": 5000
            }
          }
        },
        "T5": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "checked": {
              "type": "array",
              "items": {
                "type": "boolean"
              },
              "minItems": 4,
              "maxItems": 4,
              "description": "Verification items in order: Custody of data and keys; Encryption and trust boundaries; Backups and restoration; Vendor-failure scenarios"
            },
            "notes": {
              "type": "string",
              "maxLength": 5000
            }
          }
        },
        "T6": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "checked": {
              "type": "array",
              "items": {
                "type": "boolean"
              },
              "minItems": 3,
              "maxItems": 3,
              "description": "Verification items in order: Documented interfaces and formats; Replaceable components; Boundaries that support long-term maintenance"
            },
            "notes": {
              "type": "string",
              "maxLength": 5000
            }
          }
        },
        "T7": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "checked": {
              "type": "array",
              "items": {
                "type": "boolean"
              },
              "minItems": 3,
              "maxItems": 3,
              "description": "Verification items in order: Usable for its intended tasks; Accessible; Reasonably responsive for its domain"
            },
            "notes": {
              "type": "string",
              "maxLength": 5000
            }
          }
        }
      }
    },
    "derived": {
      "type": "object",
      "description": "Informational only. Ignored on import.",
      "properties": {
        "note": {
          "type": "string"
        },
        "complete": {
          "type": "boolean"
        },
        "determination": {
          "enum": [
            "meets_core",
            "partially_aligned",
            "fails_fundamental",
            "insufficient_evidence"
          ]
        }
      }
    }
  }
}
