{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sovereign.polla.dev/schema/assessment-2.0.schema.json",
  "title": "Sovereign Software Assessment, schema version 2.0",
  "description": "Export format of the Sovereign Software Evaluator. Derived values (score, classification) are informational and are recomputed on import.",
  "type": "object",
  "required": [
    "schemaVersion"
  ],
  "properties": {
    "schemaVersion": {
      "const": "2.0"
    },
    "framework": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      }
    },
    "software": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "maxLength": 200
        },
        "version": {
          "type": "string",
          "maxLength": 200
        },
        "category": {
          "type": "string",
          "maxLength": 200
        },
        "platform": {
          "type": "string",
          "maxLength": 200
        },
        "deployment": {
          "type": "string",
          "maxLength": 200
        }
      }
    },
    "evaluation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "date": {
          "type": "string",
          "pattern": "^(\\d{4}-\\d{2}-\\d{2})?$"
        },
        "evaluator": {
          "type": "string",
          "maxLength": 200
        },
        "notes": {
          "type": "string",
          "maxLength": 5000
        }
      }
    },
    "eligibility": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "E1": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "status": {
              "enum": [
                "pass",
                "fail",
                "not_verified",
                "not_applicable"
              ]
            },
            "evidence": {
              "type": "string",
              "maxLength": 5000
            },
            "justification": {
              "type": "string",
              "maxLength": 5000
            },
            "source": {
              "type": "string",
              "maxLength": 2000,
              "pattern": "^(https?://\\S+)?$"
            }
          }
        },
        "E2": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "status": {
              "enum": [
                "pass",
                "fail",
                "not_verified",
                "not_applicable"
              ]
            },
            "evidence": {
              "type": "string",
              "maxLength": 5000
            },
            "justification": {
              "type": "string",
              "maxLength": 5000
            },
            "source": {
              "type": "string",
              "maxLength": 2000,
              "pattern": "^(https?://\\S+)?$"
            }
          }
        },
        "E3": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "status": {
              "enum": [
                "pass",
                "fail",
                "not_verified",
                "not_applicable"
              ]
            },
            "evidence": {
              "type": "string",
              "maxLength": 5000
            },
            "justification": {
              "type": "string",
              "maxLength": 5000
            },
            "source": {
              "type": "string",
              "maxLength": 2000,
              "pattern": "^(https?://\\S+)?$"
            }
          }
        },
        "E4": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "status": {
              "enum": [
                "pass",
                "fail",
                "not_verified",
                "not_applicable"
              ]
            },
            "evidence": {
              "type": "string",
              "maxLength": 5000
            },
            "justification": {
              "type": "string",
              "maxLength": 5000
            },
            "source": {
              "type": "string",
              "maxLength": 2000,
              "pattern": "^(https?://\\S+)?$"
            }
          }
        },
        "E5": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "status": {
              "enum": [
                "pass",
                "fail",
                "not_verified",
                "not_applicable"
              ]
            },
            "evidence": {
              "type": "string",
              "maxLength": 5000
            },
            "justification": {
              "type": "string",
              "maxLength": 5000
            },
            "source": {
              "type": "string",
              "maxLength": 2000,
              "pattern": "^(https?://\\S+)?$"
            }
          }
        }
      }
    },
    "principles": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sovereignty": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "rating": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0,
              "maximum": 5
            },
            "evidence": {
              "type": "string",
              "maxLength": 5000
            },
            "limitations": {
              "type": "string",
              "maxLength": 5000
            },
            "confidence": {
              "enum": [
                null,
                "high",
                "medium",
                "low"
              ]
            },
            "sources": {
              "type": "string",
              "maxLength": 5000,
              "description": "One http or https URL per line"
            }
          }
        },
        "longevity": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "rating": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0,
              "maximum": 5
            },
            "evidence": {
              "type": "string",
              "maxLength": 5000
            },
            "limitations": {
              "type": "string",
              "maxLength": 5000
            },
            "confidence": {
              "enum": [
                null,
                "high",
                "medium",
                "low"
              ]
            },
            "sources": {
              "type": "string",
              "maxLength": 5000,
              "description": "One http or https URL per line"
            }
          }
        },
        "locality": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "rating": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0,
              "maximum": 5
            },
            "evidence": {
              "type": "string",
              "maxLength": 5000
            },
            "limitations": {
              "type": "string",
              "maxLength": 5000
            },
            "confidence": {
              "enum": [
                null,
                "high",
                "medium",
                "low"
              ]
            },
            "sources": {
              "type": "string",
              "maxLength": 5000,
              "description": "One http or https URL per line"
            }
          }
        },
        "predictability": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "rating": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0,
              "maximum": 5
            },
            "evidence": {
              "type": "string",
              "maxLength": 5000
            },
            "limitations": {
              "type": "string",
              "maxLength": 5000
            },
            "confidence": {
              "enum": [
                null,
                "high",
                "medium",
                "low"
              ]
            },
            "sources": {
              "type": "string",
              "maxLength": 5000,
              "description": "One http or https URL per line"
            }
          }
        },
        "interoperability": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "rating": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0,
              "maximum": 5
            },
            "evidence": {
              "type": "string",
              "maxLength": 5000
            },
            "limitations": {
              "type": "string",
              "maxLength": 5000
            },
            "confidence": {
              "enum": [
                null,
                "high",
                "medium",
                "low"
              ]
            },
            "sources": {
              "type": "string",
              "maxLength": 5000,
              "description": "One http or https URL per line"
            }
          }
        },
        "responsiveness": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "rating": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0,
              "maximum": 5
            },
            "evidence": {
              "type": "string",
              "maxLength": 5000
            },
            "limitations": {
              "type": "string",
              "maxLength": 5000
            },
            "confidence": {
              "enum": [
                null,
                "high",
                "medium",
                "low"
              ]
            },
            "sources": {
              "type": "string",
              "maxLength": 5000,
              "description": "One http or https URL per line"
            }
          }
        }
      }
    },
    "tests": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "T1": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "checked": {
              "type": "array",
              "items": {
                "type": "boolean"
              },
              "minItems": 5,
              "maxItems": 5,
              "description": "Verification items in order: Independent data access; Practical export; Migration to another tool; Vendor exit; Relevant cryptographic key custody"
            },
            "notes": {
              "type": "string",
              "maxLength": 5000
            }
          }
        },
        "T2": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "checked": {
              "type": "array",
              "items": {
                "type": "boolean"
              },
              "minItems": 5,
              "maxItems": 5,
              "description": "Verification items in order: Long-term readable or documented formats; Complete recovery of meaningful information; Tested backups and restoration; Independent reconstruction; Surviving documentation and schemas"
            },
            "notes": {
              "type": "string",
              "maxLength": 5000
            }
          }
        },
        "T3": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "checked": {
              "type": "array",
              "items": {
                "type": "boolean"
              },
              "minItems": 4,
              "maxItems": 4,
              "description": "Verification items in order: Essential local functions without internet access; Graceful disconnection; Local data access and modification; Optional synchronization boundaries"
            },
            "notes": {
              "type": "string",
              "maxLength": 5000
            }
          }
        },
        "T4": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "checked": {
              "type": "array",
              "items": {
                "type": "boolean"
              },
              "minItems": 5,
              "maxItems": 5,
              "description": "Verification items in order: Critical state-machine behavior; Defined numerical assumptions and tolerances; Reproducible calculations where appropriate; Conflict handling; Human authorization for consequential AI-generated actions"
            },
            "notes": {
              "type": "string",
              "maxLength": 5000
            }
          }
        },
        "T5": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "checked": {
              "type": "array",
              "items": {
                "type": "boolean"
              },
              "minItems": 4,
              "maxItems": 4,
              "description": "Verification items in order: Open interfaces and formats; Replaceable components; Documented integration; Coherent functional boundaries"
            },
            "notes": {
              "type": "string",
              "maxLength": 5000
            }
          }
        },
        "T6": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "checked": {
              "type": "array",
              "items": {
                "type": "boolean"
              },
              "minItems": 5,
              "maxItems": 5,
              "description": "Verification items in order: Routine input feedback; Perceived latency; Nonblocking expensive operations; Interface clarity; Avoidance of artificial friction"
            },
            "notes": {
              "type": "string",
              "maxLength": 5000
            }
          }
        },
        "T7": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "checked": {
              "type": "array",
              "items": {
                "type": "boolean"
              },
              "minItems": 6,
              "maxItems": 6,
              "description": "Verification items in order: Unnecessary vendor dependencies; Undisclosed telemetry; Recovery from service failure; Authentication and encryption boundaries; Dependency maintenance; Sustainable continuity"
            },
            "notes": {
              "type": "string",
              "maxLength": 5000
            }
          }
        }
      }
    },
    "derived": {
      "type": "object",
      "description": "Informational only. Ignored on import.",
      "properties": {
        "note": {
          "type": "string"
        },
        "complete": {
          "type": "boolean"
        },
        "score": {
          "type": [
            "number",
            "null"
          ]
        },
        "classification": {
          "enum": [
            "tier1",
            "tier2",
            "tier3",
            "not_certified",
            "unverified"
          ]
        }
      }
    }
  }
}
